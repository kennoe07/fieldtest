{
  "name": "fieldtest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:testnet": "node scripts/start-testnet-lab.mjs",
    "test:testnet-lab": "node scripts/test-testnet-lab.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:cloud": "node scripts/test-cloud.mjs",
    "test:wallet": "node scripts/test-wallet.mjs",
    "test:rewards": "node scripts/test-reward-transactions.mjs",
    "test:drafts": "node scripts/test-drafts.mjs",
    "test:results": "node scripts/test-results.mjs",
    "test:findings": "node scripts/test-findings.mjs",
    "test:reward-documents": "node scripts/test-reward-documents.mjs",
    "test:reward-records": "node scripts/test-reward-records.mjs",
    "test:reward-verifier": "node scripts/test-reward-verifier.mjs",
    "test:reward-worker": "node scripts/test-reward-worker.mjs && node scripts/test-reward-records.mjs --worker",
    "test:reward-context": "node scripts/test-reward-context.mjs && node scripts/test-reward-records.mjs --worker --context",
    "test:reward-intents": "node scripts/test-reward-intents.mjs && node scripts/test-reward-records.mjs --worker --context --intents",
    "test:reward-testnet": "node scripts/test-reward-testnet.mjs",
    "test:reward-publication": "node scripts/test-reward-publication.mjs",
    "test:publication-session": "node scripts/test-publication-session.mjs",
    "test:publication-wallet-signing": "node scripts/test-publication-wallet-signing.mjs",
    "test:cloud:rewards": "node scripts/test-cloud.mjs --reward-records"
  },
  "dependencies": {
    "@mysten/dapp-kit-react": "^2.1.45",
    "@mysten/sui": "^2.39.1",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
